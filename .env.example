# Read-only for Phase 0/1 (wallet tracking + backtesting) — no keys needed,
# data-api.polymarket.com and gamma-api.polymarket.com are public/unauthenticated.

# How often the tracking daemon (npm run track:daemon) polls each wallet (ms)
POLL_INTERVAL_MS=60000

# SQLite database file (default: data/polycopytrade.db)
# DB_PATH=

# Per-request timeout for outbound Polymarket API calls (ms)
API_TIMEOUT_MS=15000

# Max retries for a single API call (429s / transient errors). Bounded —
# never retries forever.
API_MAX_RETRIES=5

# --- Execution (Phase 3+, not wired up yet) ---
# Signer private key for a Polymarket Deposit Wallet / allowlisted EOA.
# Leave unset until we deliberately decide to go live.
# CLOB_SIGNER_PRIVATE_KEY=
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# --- Solana wallet-data scaffolding (multi-market expansion, Phase C --
# see docs/MULTI_MARKET_ARCHITECTURE.md and src/markets/solana/client.ts) ---
# NOT WIRED TO ANYTHING LIVE YET. src/markets/solana/client.ts is scaffolding
# for a future Solana wallet-scoring adapter -- no code in src/scoring/ or
# src/backtesting/ reads these, and nothing in the tracking daemon or paper
# trading loop touches this file. Safe to leave unset; only needed once
# Phase D (real Solana wallet-scoring integration, not started) picks this
# back up and someone deliberately gets a key from each provider's dashboard.
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
