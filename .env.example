# Read-only for Phase 0/1 (wallet tracking + backtesting) — no keys needed,
# data-api.polymarket.com and gamma-api.polymarket.com are public/unauthenticated.

# How often to poll tracked wallets' positions/activity (ms)
POLL_INTERVAL_MS=60000

# --- Execution (Phase 3+, not wired up yet) ---
# Signer private key for a Polymarket Deposit Wallet / allowlisted EOA.
# Leave unset until we deliberately decide to go live.
# CLOB_SIGNER_PRIVATE_KEY=
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=
