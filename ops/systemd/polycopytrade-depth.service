# systemd user service for `npm run depth:collector` (order-book snapshot
# capture for the depth-shift scoping work, docs/DEPTH_SHIFT_STRATEGY_SCOPE.md).
# Machine-specific paths -- see polycopytrade-track.service and
# docs/OPERATIONS.md.

[Unit]
Description=polycopytrade order-book depth snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/polycopytrade
# See polycopytrade-track.service's comment -- npm's shebang needs `node`
# resolvable via PATH, which systemd doesn't inherit from an interactive
# nvm-sourced shell.
Environment=PATH=%h/.nvm/versions/node/v22.23.2/bin:/usr/bin:/bin
ExecStartPre=/bin/mkdir -p %h/projects/polycopytrade/data
ExecStart=%h/.nvm/versions/node/v22.23.2/bin/npm run depth:collector
Restart=always
RestartSec=5
StandardOutput=append:%h/projects/polycopytrade/data/depth-collector.systemd.log
StandardError=append:%h/projects/polycopytrade/data/depth-collector.systemd.log

[Install]
WantedBy=default.target
