# systemd user service for `npm run depth:collector` (order-book snapshot
# capture for the depth-shift scoping work, docs/DEPTH_SHIFT_STRATEGY_SCOPE.md).
# Machine-specific paths -- see polycopytrade-track.service and
# docs/OPERATIONS.md.

[Unit]
Description=polycopytrade order-book depth snapshot collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/mdeff/polycopytrade
ExecStartPre=/bin/mkdir -p /mnt/c/Users/mdeff/polycopytrade/data
ExecStart=/home/mdeffgay/.nvm/versions/node/v22.23.2/bin/npm run depth:collector
Restart=always
RestartSec=5
StandardOutput=append:/mnt/c/Users/mdeff/polycopytrade/data/depth-collector.systemd.log
StandardError=append:/mnt/c/Users/mdeff/polycopytrade/data/depth-collector.systemd.log

[Install]
WantedBy=default.target
