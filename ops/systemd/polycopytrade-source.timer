# Track L2 (2026-09-24): schedule for polycopytrade-source.service.
# Persistent=true runs a missed trigger at the next boot/WSL start (WSL is
# often off overnight); RandomizedDelaySec spreads the start a little.

[Unit]
Description=polycopytrade: weekly category-rotating holders sourcing (timer)

[Timer]
OnCalendar=Wed *-*-* 03:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
