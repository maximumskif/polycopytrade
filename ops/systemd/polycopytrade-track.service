# systemd user service for `npm run track:daemon` (wallet polling + Phase 3
# paper trading). Machine-specific paths (this box's nvm-installed Node and
# the repo's location, both under $HOME -- written with systemd's %h
# specifier) -- regenerate with updated paths if either moves.
# See docs/OPERATIONS.md for install/enable/start instructions.

[Unit]
Description=polycopytrade wallet-tracking daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/polycopytrade
# npm's own shebang is `#!/usr/bin/env node` -- giving ExecStart npm's
# absolute path isn't enough on its own, `node` itself still has to resolve
# via PATH, which systemd does not inherit from an interactive nvm-sourced
# shell. Confirmed live 2026-09-05: without this, ExecStart failed with
# exit 127 (command not found) on every restart attempt.
Environment=PATH=%h/.nvm/versions/node/v22.23.2/bin:/usr/bin:/bin
ExecStartPre=/bin/mkdir -p %h/projects/polycopytrade/data
ExecStart=%h/.nvm/versions/node/v22.23.2/bin/npm run track:daemon
Restart=always
RestartSec=5
StandardOutput=append:%h/projects/polycopytrade/data/track-daemon.systemd.log
StandardError=append:%h/projects/polycopytrade/data/track-daemon.systemd.log

[Install]
WantedBy=default.target
