# Track L2 (2026-09-24): schedule for polycopytrade-watch.service.
# Persistent=true runs a missed trigger at the next boot/WSL start (WSL is
# often off overnight); RandomizedDelaySec spreads the start a little.

[Unit]
Description=polycopytrade: daily watchlist check, launching fired actions (timer)

[Timer]
OnCalendar=*-*-* 08:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
