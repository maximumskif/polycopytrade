{
  "name": "polycopytrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "migrate": "tsx src/storage/migrate.ts",
    "track:once": "tsx src/tracking/trackOnce.ts",
    "track:daemon": "tsx src/tracking/trackDaemon.ts",
    "wallets:health": "tsx src/tracking/health.ts",
    "status": "tsx src/cli/status.ts",
    "wallets:add": "tsx src/tracking/addWallet.ts",
    "scan-ladders": "tsx src/research/ladderScanner.ts",
    "backtest-ladder": "tsx src/legacy/backtestLadder.ts",
    "backtest-ladder-narrow": "tsx src/legacy/backtestLadderNarrow.ts",
    "wallet-stats": "tsx src/research/walletStats.ts",
    "wallet-backtest": "tsx src/legacy/walletBacktest.ts",
    "wallet-breakdown": "tsx src/legacy/walletBreakdown.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "wallet-score": "tsx src/cli/walletScore.ts",
    "follower-delay-demo": "tsx src/cli/followerDelayDemo.ts",
    "paper:report": "tsx src/cli/paperReport.ts",
    "ou-over-bias": "tsx src/research/ouOverBias.ts",
    "depth:collector": "tsx src/depthShift/snapshotCollector.ts",
    "consensus-signal": "tsx src/research/consensusSignal.ts",
    "sport-segmentation": "tsx src/research/sportSegmentation.ts",
    "volatility-breakout": "tsx src/research/volatilityBreakout.ts",
    "smart-money-divergence": "tsx src/research/smartMoneyDivergence.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  }
}
