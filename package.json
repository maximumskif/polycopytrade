{
  "name": "polycopytrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "migrate": "tsx src/storage/migrate.ts",
    "track:once": "tsx src/tracking/trackOnce.ts",
    "track:daemon": "tsx src/tracking/trackDaemon.ts",
    "wallets:health": "tsx src/tracking/health.ts",
    "wallets:add": "tsx src/tracking/addWallet.ts",
    "scan-ladders": "tsx src/ladderScanner.ts",
    "backtest-ladder": "tsx src/backtestLadder.ts",
    "backtest-ladder-narrow": "tsx src/backtestLadderNarrow.ts",
    "wallet-stats": "tsx src/walletStats.ts",
    "wallet-backtest": "tsx src/walletBacktest.ts",
    "wallet-breakdown": "tsx src/walletBreakdown.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "wallet-score": "tsx src/cli/walletScore.ts",
    "follower-delay-demo": "tsx src/cli/followerDelayDemo.ts",
    "paper:report": "tsx src/cli/paperReport.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
